filters:
  and:
    - file.ext == "md"
    - file.hasTag("research")
formulas:
  days_old: (now() - file.mtime).days.round(0)
properties:
  file.name:
    displayName: File
  title:
    displayName: Title
  company:
    displayName: Company
  date:
    displayName: Date
  broker:
    displayName: Broker
  source:
    displayName: Source
  formula.days_old:
    displayName: Days Old
views:
  - type: table
    name: Recent Reports
    order:
      - file.name
      - date
      - company
      - title
      - broker
      - source
      - formula.days_old
    sort:
      - property: date
        direction: DESC
    limit: 100
    summaries:
      formula.days_old: Average
  - type: table
    name: By Company
    groupBy:
      property: company
      direction: ASC
    order:
      - file.name
      - company
      - date
      - title
      - broker
      - source
    sort:
      - property: date
        direction: DESC
  - type: table
    name: By Date (Latest First)
    order:
      - file.name
      - date
      - company
      - title
      - broker
    sort:
      - property: date
        direction: DESC
    limit: 100
