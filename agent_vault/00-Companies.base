filters:
  and:
    - file.ext == "md"
    - file.inFolder("Companies")
    - type == "company"
formulas:
  region: if(file.path.contains("/KR/"), "KR", if(file.path.contains("/US/"), "US", if(file.path.contains("/CN/"), "CN", if(file.path.contains("/TW/"), "TW", if(file.path.contains("/JP/"), "JP", if(file.path.contains("/Private/"), "Private", ""))))))
  status_icon: if(active, "✅", "⏳")
properties:
  company:
    displayName: Company
  ticker:
    displayName: Ticker
  exchange:
    displayName: Exchange
  sector:
    displayName: Sector
  industry:
    displayName: Industry
  active:
    displayName: Active
  updated:
    displayName: Updated
  formula.region:
    displayName: Region
  formula.status_icon:
    displayName: Status
views:
  - type: table
    name: All Companies
    groupBy:
      property: formula.region
      direction: ASC
    order:
      - formula.region
      - company
      - ticker
      - exchange
      - sector
      - industry
      - formula.status_icon
      - updated
    limit: 100
  - type: table
    name: Active Only
    filters:
      and:
        - active == true
    groupBy:
      property: sector
      direction: ASC
    order:
      - formula.region
      - company
      - ticker
      - sector
      - industry
  - type: table
    name: By Sector
    groupBy:
      property: sector
      direction: ASC
    order:
      - sector
      - formula.region
      - company
      - ticker
